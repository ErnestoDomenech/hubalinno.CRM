@page "/investors"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject InvestorsApiClient InvestorsApi
@inject NavigationManager Nav

<PageTitle>Investors</PageTitle>

<div class="mb-4">
    <h1 class="hub-page-title mb-1">Investor CRM</h1>
    <div class="hub-subtitle">
        Fundraising pipeline and investor relationship management
    </div>
</div>

<div class="d-flex justify-content-end mb-3">
    <a class="btn hub-btn-primary" href="/investors/new">
        New investor
    </a>
</div>

@if (investors is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row mb-4">

            <div class="col-md-3 mb-3">
                <div class="card h-100 hub-card">
                    <div class="card-body">
                        <div class="hub-metric-label">Targets</div>
                        <div class="hub-metric-value">@investors.Count</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card h-100 hub-card">
                    <div class="card-body">
                        <div class="hub-metric-label">Active relationships</div>
                        <div class="hub-metric-value">@ActiveRelationships</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card h-100 hub-card">
                    <div class="card-body">
                        <div class="hub-metric-label">Overdue</div>
                        <div class="hub-metric-value">@OverdueActions</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card h-100 hub-card">
                    <div class="card-body">
                        <div class="hub-metric-label">Next 7 days</div>
                        <div class="hub-metric-value">@NextSevenDays</div>
                    </div>
                </div>
            </div>

    </div>
    <div class="row mb-4 g-2 align-items-end">

        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input class="form-control"
                   @bind="search"
                   @bind:event="oninput"
                   placeholder="Investor or partner..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Pipeline</label>

            <select class="form-select" @bind="selectedPipeline">
                <option value="">All stages</option>
                <option value="@InvestorPipelineStage.Target">Target</option>
                <option value="@InvestorPipelineStage.Research">Research</option>
                <option value="@InvestorPipelineStage.WarmIntro">Warm intro</option>
                <option value="@InvestorPipelineStage.Contacted">Contacted</option>
                <option value="@InvestorPipelineStage.Conversation">Conversation</option>
                <option value="@InvestorPipelineStage.MaterialsSent">Materials sent</option>
                <option value="@InvestorPipelineStage.DueDiligence">Due diligence</option>
                <option value="@InvestorPipelineStage.Investing">Investing</option>
                <option value="@InvestorPipelineStage.Passed">Passed</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Temperature</label>

            <select class="form-select" @bind="selectedTemperature">
                <option value="">All</option>
                <option value="@RelationshipTemperature.Cold">Cold</option>
                <option value="@RelationshipTemperature.Warm">Warm</option>
                <option value="@RelationshipTemperature.Active">Active</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Next action</label>

            <select class="form-select" @bind="selectedNextAction">
                <option value="">All</option>
                <option value="overdue">Overdue</option>
                <option value="7days">Next 7 days</option>
                <option value="none">No next action</option>
            </select>
        </div>

    </div>

    @if (!FilteredInvestors.Any())
    {
        <div class="alert alert-secondary">
            No investors match the current filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle hub-table">
                <thead>
                    <tr>
                        <th>Investor</th>
                        <th>Partner</th>
                        <th>Stage</th>
                        <th>Fit</th>
                        <th>Access</th>
                        <th>Temperature</th>
                        <th>Pipeline</th>
                        <th>Last interaction</th>
                        <th>Next action</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var investor in FilteredInvestors)
                    {
                        <tr style="cursor:pointer"
                            @onclick='() => Nav.NavigateTo($"/investors/{investor.AccountId}")'>
                            <td>
                                <strong>@investor.InvestorName</strong>
                            </td>

                            <td>
                                @(investor.PrimaryContactName ?? "—")
                            </td>

                            <td>
                                @(investor.InvestmentStage ?? "—")
                            </td>

                            <td>
                                <span class="hub-score">
                                    @ScoreLabel(investor.ThesisFit)
                                </span>
                            </td>

                            <td>
                                <span class="hub-score">
                                    @ScoreLabel(investor.AccessScore)
                                </span>
                            </td>

                            <td>
                                <span class="@TemperatureCss(investor.RelationshipTemperature)">
                                    @TemperatureLabel(investor.RelationshipTemperature)
                                </span>
                            </td>

                            <td>
                                <span class="badge rounded-pill text-bg-light">
                                    @PipelineStageLabel(investor.PipelineStage)
                                </span>
                            </td>

                            <td>
                                @(investor.LastInteraction?.ToString("dd/MM/yyyy") ?? "—")
                            </td>

                            <td>
                                <span class="hub-next-action">
                                    @(investor.NextAction ?? "—")
                                </span>
                            </td>

                            <td class="@NextActionDateCss(investor)">
                                @(investor.NextActionDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteAsync(investor.AccountId)"
                                        @onclick:stopPropagation="true">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<InvestorDto>? investors;

    protected override Task OnInitializedAsync() => LoadAsync();

    private int ActiveRelationships =>
    investors?.Count(i =>
        i.RelationshipTemperature == RelationshipTemperature.Active) ?? 0;

    private int OverdueActions =>
        investors?.Count(i =>
            i.NextActionDate.HasValue &&
            i.NextActionDate.Value.Date < DateTime.Today) ?? 0;

    private int NextSevenDays =>
        investors?.Count(i =>
            i.NextActionDate.HasValue &&
            i.NextActionDate.Value.Date >= DateTime.Today &&
            i.NextActionDate.Value.Date <= DateTime.Today.AddDays(7)) ?? 0;

    private int PendingNextActions =>
        investors?.Count(i =>
            i.NextActionDate.HasValue) ?? 0;

    private static string ScoreLabel(int score)
        => score > 0 ? $"{score}/5" : "—";

    private static string TemperatureLabel(RelationshipTemperature temperature)
        => temperature switch
        {
            RelationshipTemperature.Cold => "Cold",
            RelationshipTemperature.Warm => "Warm",
            RelationshipTemperature.Active => "Active",
            _ => temperature.ToString()
        };

    private string search = "";
    private string selectedPipeline = "";
    private string selectedTemperature = "";
    private string selectedNextAction = "";

    private async Task DeleteAsync(int accountId)
    {
        await InvestorsApi.DeleteAsync(accountId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        investors = await InvestorsApi.GetAllAsync();
    }

    private static string TemperatureCss(RelationshipTemperature temperature)
    => temperature switch
    {
        RelationshipTemperature.Cold =>
            "badge rounded-pill hub-badge-cold",

        RelationshipTemperature.Warm =>
            "badge rounded-pill hub-badge-warm",

        RelationshipTemperature.Active =>
            "badge rounded-pill hub-badge-active",

        _ =>
            "badge rounded-pill text-bg-secondary"
    };

    private static string PipelineStageLabel(InvestorPipelineStage stage)
    => stage switch
    {
        InvestorPipelineStage.Target => "Target",
        InvestorPipelineStage.Research => "Research",
        InvestorPipelineStage.WarmIntro => "Warm intro",
        InvestorPipelineStage.Contacted => "Contacted",
        InvestorPipelineStage.Conversation => "Conversation",
        InvestorPipelineStage.MaterialsSent => "Materials sent",
        InvestorPipelineStage.DueDiligence => "Due diligence",
        InvestorPipelineStage.Investing => "Investing",
        InvestorPipelineStage.Passed => "Passed",
        _ => stage.ToString()
    };

    private IEnumerable<InvestorDto> FilteredInvestors
    {
        get
        {
            if (investors is null)
                return [];

            IEnumerable<InvestorDto> result = investors;

            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();

                result = result.Where(i =>
                    i.InvestorName.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    (i.PrimaryContactName != null &&
                     i.PrimaryContactName.Contains(
                         term,
                         StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(selectedPipeline)
                && Enum.TryParse<InvestorPipelineStage>(
                    selectedPipeline,
                    out var pipeline))
            {
                result = result.Where(i =>
                    i.PipelineStage == pipeline);
            }

            if (!string.IsNullOrWhiteSpace(selectedTemperature)
                && Enum.TryParse<RelationshipTemperature>(
                    selectedTemperature,
                    out var temperature))
            {
                result = result.Where(i =>
                    i.RelationshipTemperature == temperature);
            }

            var today = DateTime.Today;

            if (selectedNextAction == "overdue")
            {
                result = result.Where(i =>
                    i.NextActionDate.HasValue &&
                    i.NextActionDate.Value.Date < today);
            }
            else if (selectedNextAction == "7days")
            {
                var limit = today.AddDays(7);

                result = result.Where(i =>
                    i.NextActionDate.HasValue &&
                    i.NextActionDate.Value.Date >= today &&
                    i.NextActionDate.Value.Date <= limit);
            }
            else if (selectedNextAction == "none")
            {
                result = result.Where(i =>
                    !i.NextActionDate.HasValue);
            }

            return result
                .OrderBy(i =>
                    i.PipelineStage == InvestorPipelineStage.Passed ? 1 : 0)
                .ThenBy(i =>
                    i.NextActionDate.HasValue ? 0 : 1)
                .ThenBy(i => i.NextActionDate)
                .ThenBy(i => i.InvestorName);
        }
    }

    private static string NextActionDateCss(InvestorDto investor)
    {
        if (!investor.NextActionDate.HasValue)
            return "";

        return investor.NextActionDate.Value.Date < DateTime.Today
            ? "text-danger fw-semibold"
            : "";
    }


}