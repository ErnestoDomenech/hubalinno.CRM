@page "/accounts"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AccountsApiClient AccountsApi
@inject NavigationManager Nav

<PageTitle>Cuentas</PageTitle>

<h1>Cuentas</h1>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label">Tipo</label>
        <select class="form-select" @bind="selectedType" @bind:after="LoadAsync">
            <option value="">Todos</option>
            <option value="@AccountType.Individual">Profesional</option>
            <option value="@AccountType.Company">Empresa</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Categoría</label>
        <select class="form-select"
                @bind="selectedCategory"
                @bind:after="LoadAsync">
            <option value="">Todas</option>
            <option value="@AccountCategory.Customer">Cliente</option>
            <option value="@AccountCategory.Investor">Investor</option>
            <option value="@AccountCategory.Partner">Partner</option>
            <option value="@AccountCategory.Supplier">Supplier</option>
            <option value="@AccountCategory.Other">Other</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Buscar</label>
        <input class="form-control" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Nombre o email" />
    </div>
    <div class="col-auto ms-auto">
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/accounts/new")'>Nueva cuenta</button>
    </div>
</div>

@if (accounts is null)
{
    <p>Cargando...</p>
}
else if (accounts.Count == 0)
{
    <p>No hay cuentas que coincidan con el filtro.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Categoría</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Ciudad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in accounts)
            {
                <tr style="cursor:pointer" @onclick='() => Nav.NavigateTo($"/accounts/{account.Id}")'>
                    <td>@account.DisplayName</td>
                    <td>@(account.AccountType == AccountType.Company ? "Empresa" : "Profesional")</td>
                    <td>@CategoryLabel(account.AccountCategory)</td>
                    <td>@account.Email</td>
                    <td>@account.Phone</td>
                    <td>@account.City</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AccountDto>? accounts;
    private string selectedType = "";
    private string search = "";
    private string selectedCategory = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        AccountType? type =
        string.IsNullOrEmpty(selectedType)
            ? null
            : Enum.Parse<AccountType>(selectedType);

        AccountCategory? category =
            string.IsNullOrEmpty(selectedCategory)
                ? null
                : Enum.Parse<AccountCategory>(selectedCategory);

        accounts = await AccountsApi.GetAllAsync(
            type: type,
            search: search,
            category: category);
    }

    private static string CategoryLabel(AccountCategory category)
    => category switch
    {
        AccountCategory.Customer => "Cliente",
        AccountCategory.Investor => "Investor",
        AccountCategory.Partner => "Partner",
        AccountCategory.Supplier => "Supplier",
        AccountCategory.Other => "Other",
        _ => category.ToString()
    };
}
