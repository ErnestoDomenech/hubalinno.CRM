@page "/timeon/agenda"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ActivitiesApiClient ActivitiesApi
@inject AccountsApiClient AccountsApi
@inject ContactsApiClient ContactsApi

<PageTitle>Agenda TimeOn</PageTitle>

<h1>Agenda comercial TimeOn</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button type="button" class="nav-link @(bucket == ActivityBucket.Today ? "active" : "")" @onclick="() => SelectBucket(ActivityBucket.Today)">Hoy</button></li>
    <li class="nav-item"><button type="button" class="nav-link @(bucket == ActivityBucket.Overdue ? "active" : "")" @onclick="() => SelectBucket(ActivityBucket.Overdue)">Vencidas</button></li>
    <li class="nav-item"><button type="button" class="nav-link @(bucket == ActivityBucket.Next7Days ? "active" : "")" @onclick="() => SelectBucket(ActivityBucket.Next7Days)">Próximos 7 días</button></li>
    <li class="nav-item"><button type="button" class="nav-link @(bucket == ActivityBucket.Completed ? "active" : "")" @onclick="() => SelectBucket(ActivityBucket.Completed)">Completadas</button></li>
</ul>

<h5>Registro rápido</h5>
<div class="btn-group mb-3">
    <button class="btn btn-outline-primary" @onclick="() => StartQuickLog(ActivityType.LinkedIn)">LinkedIn</button>
    <button class="btn btn-outline-primary" @onclick="() => StartQuickLog(ActivityType.Email)">Email</button>
    <button class="btn btn-outline-primary" @onclick="() => StartQuickLog(ActivityType.Call)">Llamada</button>
    <button class="btn btn-outline-primary" @onclick="() => StartQuickLog(ActivityType.Conversation)">Conversación</button>
    <button class="btn btn-outline-primary" @onclick="() => StartQuickLog(ActivityType.Task)">Seguimiento</button>
</div>

@if (quickLogType.HasValue)
{
    <EditForm Model="quickLog" OnValidSubmit="SaveQuickLogAsync" class="col-lg-8 border rounded p-3 mb-4">
        <h6>@QuickLogTitle</h6>
        <div class="row">
            <div class="col mb-2">
                <label class="form-label">Cuenta</label>
                <select class="form-select" @bind="quickLog.AccountId" @bind:after="OnQuickLogAccountChangedAsync">
                    <option value="">Selecciona una cuenta</option>
                    @foreach (var a in accounts ?? [])
                    {
                        <option value="@a.Id">@a.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col mb-2">
                <label class="form-label">Contacto (opcional)</label>
                <select class="form-select" @bind="quickLog.ContactId">
                    <option value="">Ninguno</option>
                    @foreach (var c in quickLogContacts ?? [])
                    {
                        <option value="@c.Id">@c.FirstName @c.LastName</option>
                    }
                </select>
            </div>
        </div>
        <div class="mb-2">
            <InputText class="form-control" @bind-Value="quickLog.Subject" placeholder="Asunto" />
        </div>
        <div class="mb-2">
            <InputTextArea class="form-control" @bind-Value="quickLog.Description" placeholder="Notas (opcional)" />
        </div>
        <div class="mb-2">
            <label class="form-label">Próxima fecha (opcional, si queda pendiente)</label>
            <InputDate class="form-control" @bind-Value="quickLog.DueDate" />
        </div>
        <button type="submit" class="btn btn-primary">Registrar</button>
        <button type="button" class="btn btn-secondary" @onclick="() => quickLogType = null">Cancelar</button>
    </EditForm>
}

@if (activities is null)
{
    <p>Cargando...</p>
}
else if (activities.Count == 0)
{
    <p>No hay actividades en esta vista.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Cuenta</th>
                <th>Contacto</th>
                <th>Asunto</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var act in activities)
            {
                <tr>
                    <td>@TypeLabel(act.Type)</td>
                    <td>@act.AccountDisplayName</td>
                    <td>@act.ContactName</td>
                    <td>@act.Subject</td>
                    <td>@(act.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (bucket != ActivityBucket.Completed)
                        {
                            @if (completingId == act.Id)
                            {
                                <div class="d-flex gap-1">
                                    <input class="form-control form-control-sm" @bind="nextSubject" placeholder="Siguiente acción" />
                                    <input class="form-control form-control-sm" type="date" @bind="nextDate" />
                                    <button class="btn btn-sm btn-primary" @onclick="() => ConfirmCompleteAndCreateNextAsync(act)">Guardar</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => completingId = null">Cancelar</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => StartCompleteAndNext(act)">Completar y crear siguiente</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ActivityBucket bucket = ActivityBucket.Today;
    private List<ActivityDto>? activities;
    private List<AccountDto>? accounts;
    private List<ContactDto>? quickLogContacts;

    private ActivityType? quickLogType;
    private ActivityDto quickLog = new();

    private int? completingId;
    private string nextSubject = "";
    private DateTime? nextDate = DateTime.Today.AddDays(1);

    private string QuickLogTitle => quickLogType switch
    {
        ActivityType.LinkedIn => "Registrar contacto por LinkedIn",
        ActivityType.Email => "Registrar email",
        ActivityType.Call => "Registrar llamada",
        ActivityType.Conversation => "Registrar conversación",
        ActivityType.Task => "Registrar seguimiento",
        _ => "Registrar actividad",
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SelectBucket(ActivityBucket newBucket)
    {
        bucket = newBucket;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        activities = await ActivitiesApi.GetAllAsync(businessLine: BusinessLine.TimeOn, bucket: bucket);
    }

    private async Task StartQuickLog(ActivityType type)
    {
        accounts ??= await AccountsApi.GetAllAsync(businessLine: BusinessLine.TimeOn);
        quickLog = new ActivityDto { Type = type, Status = ActivityStatus.Done };
        quickLogType = type;
    }

    private async Task OnQuickLogAccountChangedAsync()
    {
        quickLogContacts = quickLog.AccountId.HasValue ? await ContactsApi.GetByAccountAsync(quickLog.AccountId.Value) : [];
    }

    private async Task SaveQuickLogAsync()
    {
        if (quickLog.AccountId is null || string.IsNullOrWhiteSpace(quickLog.Subject)) return;

        quickLog.BusinessLine = BusinessLine.TimeOn;
        // Si se informa una fecha, queda pendiente (es la próxima acción); si no, se registra como ya completada.
        quickLog.Status = quickLog.DueDate.HasValue ? ActivityStatus.Pending : ActivityStatus.Done;

        await ActivitiesApi.CreateAsync(quickLog);
        quickLogType = null;
        await LoadAsync();
    }

    private void StartCompleteAndNext(ActivityDto act)
    {
        completingId = act.Id;
        nextSubject = act.Subject;
        nextDate = DateTime.Today.AddDays(1);
    }

    private async Task ConfirmCompleteAndCreateNextAsync(ActivityDto act)
    {
        act.Status = ActivityStatus.Done;
        await ActivitiesApi.UpdateAsync(act);

        if (!string.IsNullOrWhiteSpace(nextSubject) && nextDate.HasValue)
        {
            await ActivitiesApi.CreateAsync(new ActivityDto
            {
                AccountId = act.AccountId,
                ContactId = act.ContactId,
                OpportunityId = act.OpportunityId,
                BusinessLine = BusinessLine.TimeOn,
                Type = act.Type,
                Subject = nextSubject,
                DueDate = nextDate,
                Status = ActivityStatus.Pending,
            });
        }

        completingId = null;
        await LoadAsync();
    }

    private static string TypeLabel(ActivityType t) => t switch
    {
        ActivityType.Call => "Llamada",
        ActivityType.Email => "Email",
        ActivityType.Meeting => "Reunión",
        ActivityType.Task => "Seguimiento",
        ActivityType.Note => "Nota",
        ActivityType.LinkedIn => "LinkedIn",
        ActivityType.Conversation => "Conversación",
        _ => t.ToString(),
    };
}
